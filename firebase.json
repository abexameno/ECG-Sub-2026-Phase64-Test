{
  "firestore": {
    "database": "ai-studio-examenocbeconten-682cf46e-18e4-448b-b562-01d342c08e88",
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "exameno-ecg-srv",
          "region": "europe-west1"
        }
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
