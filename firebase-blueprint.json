{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and account information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["Admin", "Teacher", "School Admin", "Student"] },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "avatarColor": { "type": "string" },
        "schoolName": { "type": "string" },
        "credits": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "creditLogs": {
          "type": "array",
          "items": { "$ref": "#/entities/CreditLog" }
        }
      },
      "required": ["name", "email", "role", "status", "credits"]
    },
    "GeneratedContent": {
      "title": "Generated Content",
      "description": "Educational content generated by AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "questions": { "type": "array" },
        "metadata": { "type": "object" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "savedAt"]
    },
    "CreditLog": {
      "title": "Credit Log",
      "description": "Log of credit usage or purchase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "action": { "type": "string" },
        "creditsUsed": { "type": "number" },
        "balance": { "type": "number" }
      },
      "required": ["date", "action", "creditsUsed", "balance"]
    },
    "UsageLog": {
      "title": "Usage Log",
      "description": "Log of AI content generation usage",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "contentType": { "type": "string" },
        "grade": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" }
      },
      "required": ["userId", "timestamp", "contentType"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback or bug report",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "subject": { "type": "string" },
        "details": { "type": "string" },
        "user": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["New", "Read", "Resolved"] }
      },
      "required": ["type", "subject", "details", "timestamp", "status"]
    },
    "CurriculumOverride": {
      "title": "Curriculum Override",
      "description": "Customized curriculum data content",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Payment transaction record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "transactionNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING_VERIFICATION", "VERIFIED", "REJECTED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "transactionNumber", "status", "createdAt", "updatedAt"]
    },
    "ELMSInvite": {
      "title": "ELMS Student Invitation",
      "description": "Student exam practice and revision invitation via WhatsApp or Email",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "studentPhone": { "type": "string" },
        "sendMethod": { "type": "string", "enum": ["WhatsApp", "Email"] },
        "status": { "type": "string", "enum": ["Pending", "Accepted"] },
        "invitedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentName", "sendMethod", "status", "invitedAt"]
    },
    "Poll": {
      "title": "Poll",
      "description": "Custom educational feedback polls created by admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "votes": { "type": "object" },
        "voters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "message", "options", "votes", "voters", "createdAt", "createdBy"]
    },
    "PollResponse": {
      "title": "PollResponse",
      "type": "object",
      "properties": {
        "pollId": { "type": "string" },
        "userId": { "type": "string" },
        "selectedOption": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["pollId", "userId", "selectedOption"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message"]
    },
    "Referral": {
      "title": "Referral",
      "type": "object",
      "properties": {
        "inviterId": { "type": "string" },
        "inviteeEmail": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["inviterId", "inviteeEmail", "status"]
    },
    "SentEmail": {
      "title": "SentEmail",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "type": { "type": "string" },
        "sentAt": { "type": "string" }
      },
      "required": ["email", "subject"]
    },
    "ElmsConnection": {
      "title": "ELMS School Connection",
      "description": "Connection configuration and status linking ECG school tenant to ELMS institution",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "elmsSchoolId": { "type": "string" },
        "status": { "type": "string", "enum": ["CONNECTED", "NOT_CONNECTED", "NEEDS_ATTENTION", "ERROR"] },
        "connectedAt": { "type": "string", "format": "date-time" },
        "connectedBy": { "type": "string" },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "portalUrl": { "type": "string" },
        "version": { "type": "string" },
        "errorDetails": { "type": "string" }
      },
      "required": ["schoolId", "status", "connectedAt", "connectedBy", "lastVerifiedAt", "portalUrl"]
    },
    "CreditReservation": {
      "title": "CreditReservation",
      "description": "Server-authoritative atomic credit reservation for AI generation",
      "type": "object",
      "properties": {
        "reservationId": { "type": "string" },
        "uid": { "type": "string" },
        "endpoint": { "type": "string" },
        "contentType": { "type": "string" },
        "cost": { "type": "number" },
        "chunksUsed": { "type": "number" },
        "maxChunks": { "type": "number" },
        "status": { "type": "string", "enum": ["RESERVED", "COMPLETED", "REFUNDED"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "expiresAtMs": { "type": "number" }
      },
      "required": ["reservationId", "uid", "endpoint", "cost", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/credit_reservations/{reservationId}": {
      "schema": "CreditReservation",
      "description": "Server-authoritative atomic credit reservations"
    },
    "/users/{userId}/library/{contentId}": {
      "schema": "GeneratedContent",
      "description": "User's saved generated content"
    },
    "/users/{userId}/elms_invites/{inviteId}": {
      "schema": "ELMSInvite",
      "description": "User's student invitations to ELMS platform"
    },
    "/users/{userId}/illustrations/{mediaId}": {
      "schema": "object",
      "description": "User illustrations"
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": "AppNotification",
      "description": "User-specific notifications"
    },
    "/usage_logs/{logId}": {
      "schema": "UsageLog",
      "description": "System usage logs for analytics"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User submitted feedback"
    },
    "/curriculum_overrides/{key}": {
      "schema": "CurriculumOverride",
      "description": "Admin overrides for curriculum data"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Payment records"
    },
    "/polls/{pollId}": {
      "schema": "Poll",
      "description": "Admin created feedback polls for users"
    },
    "/poll_responses/{responseId}": {
      "schema": "PollResponse",
      "description": "Poll responses submitted by users"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Global or user notification items"
    },
    "/referrals/{referralId}": {
      "schema": "Referral",
      "description": "Referral invitation records"
    },
    "/sent_emails/{emailId}": {
      "schema": "SentEmail",
      "description": "Email delivery records"
    },
    "/schools/{schoolId}": {
      "schema": "object",
      "description": "School tenant configuration and profile documents"
    },
    "/schoolMemberships/{membershipId}": {
      "schema": "object",
      "description": "Deterministic school membership records (mem_{userId}_{schoolId})"
    },
    "/adminAuditLogs/{logId}": {
      "schema": "object",
      "description": "Server-authoritative audit logs for administrative user and system operations"
    },
    "/schools/{schoolId}/elms_connections/{connectionId}": {
      "schema": "ElmsConnection",
      "description": "ELMS connection parameters scoped to an authorized school tenant"
    },
    "/schools/{schoolId}/class_groups/{classId}": {
      "schema": "object",
      "description": "Tenant-scoped class groups"
    },
    "/schools/{schoolId}/learners/{learnerId}": {
      "schema": "object",
      "description": "Tenant-scoped learner profiles"
    },
    "/schools/{schoolId}/class_rosters/{rosterId}": {
      "schema": "object",
      "description": "Tenant-scoped class roster memberships"
    },
    "/schools/{schoolId}/teaching_activities/{activityId}": {
      "schema": "object",
      "description": "Tenant-scoped teaching activity records"
    },
    "/schools/{schoolId}/learner_activities/{activityId}": {
      "schema": "object",
      "description": "Tenant-scoped learner activity records"
    },
    "/schools/{schoolId}/artifacts/{artifactId}": {
      "schema": "object",
      "description": "Tenant-scoped ELMS published artifacts"
    },
    "/schools/{schoolId}/content_artifacts/{artifactId}": {
      "schema": "object",
      "description": "Tenant-scoped content artifact version repositories"
    },
    "/schools/{schoolId}/elms_publications/{publicationId}": {
      "schema": "object",
      "description": "Tenant-scoped ELMS resource publication records"
    },
    "/schools/{schoolId}/elms_assignments/{assignmentId}": {
      "schema": "object",
      "description": "Tenant-scoped ELMS assignment records"
    },
    "/schools/{schoolId}/elms_learner_mappings/{mappingId}": {
      "schema": "object",
      "description": "Tenant-scoped ELMS learner mapping records"
    },
    "/schools/{schoolId}/elms_class_mappings/{mappingId}": {
      "schema": "object",
      "description": "Tenant-scoped ELMS class mapping records"
    },
    "/schools/{schoolId}/elms_mappings/{mappingId}": {
      "schema": "object",
      "description": "Tenant-scoped ELMS mapping records"
    },
    "/schools/{schoolId}/elms_learning_events/{eventId}": {
      "schema": "object",
      "description": "Tenant-scoped ELMS learning event records"
    },
    "/schools/{schoolId}/elms_events/{eventId}": {
      "schema": "object",
      "description": "Tenant-scoped ELMS learning event records"
    },
    "/schools/{schoolId}/assessment_evidence/{evidenceId}": {
      "schema": "object",
      "description": "Tenant-scoped assessment evidence records"
    },
    "/schools/{schoolId}/elms_evidence/{evidenceRecordId}": {
      "schema": "object",
      "description": "Tenant-scoped ELMS assessment evidence records"
    },
    "/schools/{schoolId}/outcome_evidence/{evidenceId}": {
      "schema": "object",
      "description": "Tenant-scoped learning outcome evidence records"
    },
    "/schools/{schoolId}/assessment_overrides/{overrideId}": {
      "schema": "object",
      "description": "Tenant-scoped teacher assessment interpretation overrides"
    },
    "/schools/{schoolId}/teacher_actions/{actionId}": {
      "schema": "object",
      "description": "Tenant-scoped teacher action plan records"
    },
    "/schools/{schoolId}/teacher_action_comparisons/{comparisonId}": {
      "schema": "object",
      "description": "Tenant-scoped teacher action follow-up comparison records"
    },
    "/schools/{schoolId}/follow_up_comparisons/{comparisonId}": {
      "schema": "object",
      "description": "Tenant-scoped follow-up assessment comparison records"
    },
    "/schools/{schoolId}/assessments/{assessmentId}": {
      "schema": "object",
      "description": "Tenant-scoped formal assessment records"
    },
    "/schools/{schoolId}/assessment_attempts/{attemptId}": {
      "schema": "object",
      "description": "Tenant-scoped learner assessment attempts"
    },
    "/schools/{schoolId}/assessment_results/{resultId}": {
      "schema": "object",
      "description": "Tenant-scoped learner assessment results"
    },
    "/teacher_profiles/{userId}": {
      "schema": "object",
      "description": "Durable teacher onboarding profile and active teaching context state"
    }
  }
}
