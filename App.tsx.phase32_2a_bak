 const fetchSettings = async () => {
 try {
 const settingsRef = doc(db, 'settings', 'global');
 const snapshot = await getDoc(settingsRef);
 if (snapshot.exists()) {
 const settingsData = snapshot.data() as SystemSettings;
 setSystemSettings(prev => {
