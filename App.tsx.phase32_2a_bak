 switch (formState.contentType) {
 case ContentType.SchemeOfWork:
 creditCost = systemSettings.creditCostSow ?? 2;
 break;
 case ContentType.Assessment:
 case ContentType.TopicExam:
 case ContentType.TermExam:
 creditCost = systemSettings.creditCostCba ?? 2;
 break;
 case ContentType.LessonPlan:
 case ContentType.LessonNotes:
 case ContentType.RecordOfWorkCovered:
 case ContentType.StudyGuide:
 creditCost = systemSettings.creditCostLesson ?? 1;
 break;
 case ContentType.Quiz:
 creditCost = systemSettings.creditCostQuiz ?? 1;
 break;
 default:
 creditCost = 1;
 break;
 }

 if (currentUser.credits < creditCost) {
 setError(`You need ${creditCost} credits to generate this content. Please purchase more credits to continue.`);
 setActiveTab('subscription');
 return;
 }

 setIsLoading(true);
 setGenerationProgress(0);
 setError(null);
 setContent(null);
 setIsSaved(false);
 try {
 const result = await generateContent(formState, currentUser.name, currentUser.schoolName || 'Exameno School', (progress) => {
 setGenerationProgress(progress);
 });
 const contentWithTimestamp = { ...result, savedAt: new Date().toISOString(), ownerId: currentUser.id };
 
 const libraryRef = collection(db, 'users', currentUser.id, 'library');
 const docRef = doc(libraryRef);
 const contentWithId = { ...contentWithTimestamp, id: docRef.id };
 setContent(contentWithId);

 // Phase 30 & 31: If generated from a Teacher Action Plan, link the generated resource or follow-up assessment back to the action plan
 const activeActionId = formState.teacherActionId || formState.sourceTeacherActionId;
 if (activeActionId) {
  try {
   const targetSchoolId = currentUser.schoolName || formState.schoolId || 'lwps';
   TeacherActionService.recordGeneratedResource({
    actionId: activeActionId,
    schoolId: targetSchoolId,
    teacherId: currentUser.id,
    content: contentWithId,
   });
   if (formState.isFollowUpAssessment || formState.teacherActionContext?.isFollowUpAssessment) {
    TeacherActionService.linkFollowUpAssessmentToAction({
     actionId: activeActionId,
     schoolId: targetSchoolId,
     teacherId: currentUser.id,
     followUpArtifactId: contentWithId.id,
     supportingResourceId: formState.supportingResourceId || formState.teacherActionContext?.supportingResourceId,
     title: contentWithId.title,
     contentType: contentWithId.metadata?.contentType,
    });
   }
  } catch (linkErr: any) {
   console.warn('Could not link generated resource to teacher action plan:', linkErr.message);
  }
 }
 
 // Save locally immediately to make it instant and resilient
 setLibrary(prev => {
 const updated = [contentWithId, ...prev];
 try {
 localStorage.setItem(`library_${currentUser.id}`, JSON.stringify(updated));
 } catch (e) {}
 return updated;
 });

 // Attempt background cloud auto-save
 try {
 await setDoc(docRef, cleanForFirestore(stripImageData(contentWithId)));
 } catch (syncErr: any) {
 console.warn("Auto-save to cloud failed, relying on local storage fallback:", syncErr.message);
 if (isQuotaError(syncErr)) {
 setIsQuotaOffline(true);
 }
 }
 
 // Attempt logging usage
 try {
 const logsRef = collection(db, 'usage_logs');
 await setDoc(doc(logsRef), cleanForFirestore({
 userId: currentUser.id,
 userName: currentUser.name,
 timestamp: new Date().toISOString(),
