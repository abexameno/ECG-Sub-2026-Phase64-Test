 unsubscribeAuth();
 };
 }, []);

 // Library Listener
 // Implement a resilient cache to survive database offline quota situations and optimize read quota
 useEffect(() => {
 if (!firebaseUser) {
 setLibrary([]);
 return;
 }

 const cacheKey = `library_${firebaseUser.uid}`;
 const timeKey = `library_last_fetched_${firebaseUser.uid}`;

 try {
 const cachedLibrary = localStorage.getItem(cacheKey) || sessionStorage.getItem(cacheKey);
 if (cachedLibrary) {
 setLibrary(JSON.parse(cachedLibrary));
 }
 } catch (e) {}

 const libraryRef = collection(db, 'users', firebaseUser.uid, 'library');
 const q = query(libraryRef, orderBy('savedAt', 'desc'));
 
 // Fetch from Firestore only if cache is stale (>5 minutes) or empty
 const fetchLibrary = async (force = false) => {
 try {
 const cachedLibrary = localStorage.getItem(cacheKey);
 const lastFetched = localStorage.getItem(timeKey);
 const now = Date.now();

 // Skip network request if cache is fresh (less than 5 minutes old) and force is false
 if (!force && cachedLibrary && lastFetched && (now - parseInt(lastFetched) < 5 * 60 * 1000)) {
 console.log("[QUOTA SAVED] Using fresh cached library from local storage.");
 return;
 }

 const snapshot = await getDocs(q);
 const items = snapshot.docs.map((doc: any) => ({ ...doc.data(), id: doc.id } as GeneratedContent));
 setLibrary(items);
 try {
 localStorage.setItem(cacheKey, JSON.stringify(items));
 sessionStorage.setItem(cacheKey, JSON.stringify(items));
 localStorage.setItem(timeKey, now.toString());
 } catch (e) {}
 } catch (err: any) {
 console.warn("Library query failed (using local offline cache if available):", err.message);
 if (isQuotaError(err)) {
 setIsQuotaOffline(true);
 } else {
 handleFirestoreError(err, OperationType.LIST, `users/${firebaseUser.uid}/library`);
 }
 }
 };

 fetchLibrary(); // Initial smart fetch

 // Mild backup fetch every 12 hours (safeguard against quota exhaustion)
 const interval = setInterval(() => fetchLibrary(true), 12 * 60 * 60 * 1000); 

 return () => clearInterval(interval);
 }, [firebaseUser]);

 useEffect(() => {
 if (!firebaseUser) {
 setNotifications([]);
 return;
 }
 const notificationsRef = collection(db, 'notifications');
 const q = query(notificationsRef, where('userId', 'in', [firebaseUser.uid, 'all']));
 
 const unsubscribe = onSnapshot(q, (snapshot) => {
 const fetched = snapshot.docs.map(doc => ({...doc.data(), id: doc.id} as AppNotification));
 NotificationService.ingestNotifications(fetched);

 const inMemory = NotificationService.getNotificationsForUser(firebaseUser.uid);
 const notifMap = new Map<string, AppNotification>();
 inMemory.forEach(n => notifMap.set(n.id, n));
 fetched.forEach(n => notifMap.set(n.id, n));
 const combined = Array.from(notifMap.values());

 combined.sort((a, b) => {
 const getTime = (val: any) => {
 if (!val) return 0;
 if (typeof val === 'object' && val.seconds !== undefined) return val.seconds * 1000 + (val.nanoseconds || 0) / 1000000;
 if (val.toDate) return val.toDate().getTime();
 return new Date(val).getTime() || 0;
 };
 return getTime(b.createdAt) - getTime(a.createdAt);
 });
 setNotifications(combined);
 }, (error) => {
 console.warn("Firestore notifications query error, falling back to local NotificationService:", error);
 const localList = NotificationService.getNotificationsForUser(firebaseUser.uid);
 setNotifications(localList);
 });
 return unsubscribe;
 }, [firebaseUser]);

