 const markAllAsRead = async () => {
   if (!firebaseUser) return;
   const now = new Date().toISOString();
   setNotifications(prev => prev.map(n => ({ ...n, isRead: true, readAt: now })));
   await NotificationService.markAllAsRead(firebaseUser.uid);
   try {
     const unreadList = notifications.filter(n => !n.isRead);
     if (unreadList.length > 0) {
       const batch = writeBatch(db);
       unreadList.slice(0, 50).forEach(n => {
         batch.update(doc(db, 'notifications', n.id), { isRead: true, readAt: now });
       });
       await batch.commit();
     }
   } catch (err) {
     console.debug("Firestore markAllAsRead offline fallback:", err);
   }
 };

 const handleMarkAsRead = async (notificationId: string) => {
