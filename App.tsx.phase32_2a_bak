 // Admin users listener with 5-minute quota cache
 useEffect(() => {
 if (!currentUser) return;
 if (currentUser.role === 'Admin') {
 const fetchUsers = async () => {
 try {
 const cacheKey = 'all_users_cache';
 const timeKey = 'all_users_last_fetched';
 const cached = localStorage.getItem(cacheKey);
 const lastFetched = localStorage.getItem(timeKey);
 const now = Date.now();

 if (cached && lastFetched && (now - parseInt(lastFetched) < 5 * 60 * 1000)) {
 setAllUsers(JSON.parse(cached));
 return;
 }

 const usersRef = collection(db, 'users');
 const q = query(usersRef);
 const snapshot = await getDocs(q);
 const items = snapshot.docs.map(d => {
 const data = d.data() as any;
 let createdAt = data.createdAt;
 if (createdAt && typeof createdAt !== 'string') {
 try {
 createdAt = createdAt.toDate ? createdAt.toDate().toISOString() : new Date(createdAt.seconds * 1000).toISOString();
 } catch (e) {
 createdAt = new Date().toISOString();
 }
 }
 return {
 ...data,
 id: d.id,
 createdAt: createdAt || new Date('2026-01-01').toISOString()
 } as User;
 });
 setAllUsers(items);
 localStorage.setItem(cacheKey, JSON.stringify(items));
 localStorage.setItem(timeKey, now.toString());
 } catch (err: any) {
 console.log("Firestore Error in users fetch:", err);
 handleFirestoreError(err, OperationType.LIST, 'users');
 }
 };
 fetchUsers();
 } else {
 setAllUsers([]);
 }
 }, [currentUser?.role, currentUser?.id]);

 useEffect(() => {
 const unsubscribeOverrides = initializeCurriculumOverrides();
 
