 const handleGenerateResourceFromSOW = (
   resourceType: ContentType.LessonPlan | ContentType.LessonNotes,
   sowData: SchemeOfWorkData,
   entry: SchemeOfWorkEntry,
   parentArtifactId?: string
 ) => {
   const grade = sowData.grade;
   const subject = sowData.subject;
   const term = sowData.term;
   const week = entry.week;
   const lessonNumber = entry.lesson;
   const strand = entry.strand;
   const subStrand = entry.subStrand;
   const learningOutcomes = entry.learningOutcomes;

   const curriculumLessonId = `canonical-${(grade || '').toLowerCase().replace(/\s+/g, '')}-${(subject || '').toLowerCase().replace(/\s+/g, '')}-w${week}-l${lessonNumber}`;
   const scheduledLessonId = `sched-w${week}-p${lessonNumber}`;
   const topicTitle = `${strand} - ${subStrand}`;

   setFormState(prev => ({
     ...prev,
     contentType: resourceType,
     grade: grade || prev.grade,
     subject: subject || prev.subject,
     terms: term ? [term] : prev.terms,
     term: (term as any) || prev.term,
     week: week,
     lessonNumber: lessonNumber,
     topic: topicTitle,
     topicInputMode: 'curriculum',
     multiSelectTopics: strand && subStrand ? { [strand]: [subStrand] } : prev.multiSelectTopics,
     selectedWeeks: week ? [week] : prev.selectedWeeks,
     selectedLessons: week && lessonNumber ? [{ week, lesson: lessonNumber }] : prev.selectedLessons,
     additionalInstructions: `Lesson context: ${strand} > ${subStrand}. Specific Learning Outcomes: ${learningOutcomes}`,
     parentArtifactId: parentArtifactId || content?.id,
     masterSowId: parentArtifactId || content?.id,
     curriculumLessonId: curriculumLessonId,
     scheduledLessonId: scheduledLessonId,
     sowLessonContext: {
       sowTitle: content?.title || `${grade} ${subject} SOW`,
       week: week,
       lesson: lessonNumber,
       strand: strand,
       subStrand: subStrand,
       learningOutcomes: learningOutcomes,
       inquiryQuestions: entry.inquiryQuestions,
       learningExperiences: entry.learningExperiences,
       learningResources: entry.learningResources,
     }
   }));

   setActiveTab('home');
 };

 const handleMarkLessonTaughtFromSOW = async (
   sowData: SchemeOfWorkData,
   entry: SchemeOfWorkEntry,
   actualTeachingDate: string,
   parentArtifactId?: string
 ) => {
   if (!currentUser || !content) return;

   const masterSowId = parentArtifactId || content.id;
   const grade = sowData.grade;
   const subject = sowData.subject;
   const term = sowData.term;
   const week = entry.week;
   const lessonNumber = entry.lesson;
   const strand = entry.strand;
   const subStrand = entry.subStrand;

   const curriculumLessonId = `canonical-${(grade || '').toLowerCase().replace(/\s+/g, '')}-${(subject || '').toLowerCase().replace(/\s+/g, '')}-w${week}-l${lessonNumber}`;
   const scheduledLessonId = `sched-w${week}-p${lessonNumber}`;

   // 1. Update current content.schemeOfWorkData.entries if matching this SOW
   if (content.schemeOfWorkData && (content.id === masterSowId || content.metadata?.parentArtifactId === masterSowId)) {
     const updatedEntries = content.schemeOfWorkData.entries.map(e => {
       if (e.week === week && e.lesson === lessonNumber) {
         return {
           ...e,
           isTaught: true,
           actualTeachingDate: actualTeachingDate,
           taughtStatus: 'COMPLETED' as const
         };
       }
       return e;
     });

     const updatedContent = {
       ...content,
       schemeOfWorkData: {
         ...content.schemeOfWorkData,
         entries: updatedEntries
       }
     };

     setContent(updatedContent);
     setLibrary(prev => prev.map(item => item.id === content.id ? updatedContent : item));

     try {
       const userDocRef = doc(db, 'users', currentUser.id, 'library', content.id || 'temp-id');
       await setDoc(userDocRef, cleanForFirestore(stripImageData(updatedContent)), { merge: true });
     } catch (e: any) {
       console.warn("Firestore save fallback for SOW mark taught:", e.message);
     }
   }

   // 2. Ensure ROWC record or ROWC completion entry is recorded with composite key
   const rowcEntry: ROWCLessonEntry = {
     id: `rowc-entry-${masterSowId}-${week}-${lessonNumber}`,
     date: actualTeachingDate,
     grade,
     subject,
     term,
     strand,
     subStrand,
     lessonTitle: `Lesson ${lessonNumber}: ${subStrand}`,
     learningActivities: entry.learningExperiences || 'Classroom delivery completed.',
     resources: entry.learningResources || 'Standard curriculum resources.',
     assessment: entry.assessment || 'Formative assessment.',
     remarks: 'Marked as taught on schedule.'
   };

   // Check if ROWC artifact already exists for this SOW using composite key lookup
   const existingRowc = library.find(item => 
     item.metadata?.contentType === ContentType.RecordOfWorkCovered &&
     (item.metadata?.parentArtifactId === masterSowId || item.metadata?.masterSowId === masterSowId)
   );

   if (existingRowc && existingRowc.rowcData) {
     const existingLessons = existingRowc.rowcData.lessons || [];
     const exists = existingLessons.some(l => l.id === rowcEntry.id || (l.strand === strand && l.subStrand === subStrand && l.date === actualTeachingDate));
     if (!exists) {
       const updatedRowc = {
         ...existingRowc,
         rowcData: {
           ...existingRowc.rowcData,
           lessons: [rowcEntry, ...existingLessons]
         }
       };
       setLibrary(prev => prev.map(item => item.id === existingRowc.id ? updatedRowc : item));
       try {
         const userDocRef = doc(db, 'users', currentUser.id, 'library', existingRowc.id || 'temp-id');
         await setDoc(userDocRef, cleanForFirestore(stripImageData(updatedRowc)), { merge: true });
       } catch (e) {}
     }
   } else {
     const newRowcContent: GeneratedContent = {
       id: `gen_rowc_${Date.now()}`,
       ownerId: currentUser.id,
       title: `Record of Work Covered: ${grade} ${subject} (${term})`,
       rowcData: {
         weekRange: `Week ${week}`,
         lessons: [rowcEntry],
         reflection: 'All scheduled lessons delivered successfully.'
       },
       metadata: {
         schoolId: currentUser.schoolName || 'ECG',
         grade,
         subject,
         topic: `${strand} - ${subStrand}`,
         contentType: ContentType.RecordOfWorkCovered,
         term,
         parentArtifactId: masterSowId,
         masterSowId: masterSowId,
         curriculumLessonId,
         scheduledLessonId,
         week,
         lessonNumber,
         strand,
         subStrand,
         specificLearningOutcome: entry.learningOutcomes
       },
       savedAt: new Date().toISOString()
     };

     setLibrary(prev => [newRowcContent, ...prev]);
     try {
       const userDocRef = doc(db, 'users', currentUser.id, 'library', newRowcContent.id || 'temp-id');
       await setDoc(userDocRef, cleanForFirestore(stripImageData(newRowcContent)));
     } catch (e) {}
   }
 };

