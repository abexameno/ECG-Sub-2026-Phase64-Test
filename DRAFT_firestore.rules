rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() && isVerified() && userId == request.auth.uid;
      allow create: if isSignedIn() && isVerified() && userId == request.auth.uid && 
        incoming().keys().hasAll(['id', 'name', 'email', 'role', 'status', 'credits']) &&
        incoming().keys().size() <= 9 && // Optional fields possible
        incoming().role == 'Teacher' &&
        incoming().status == 'Active' &&
        incoming().id == request.auth.uid;
      allow update: if isSignedIn() && isVerified() && userId == request.auth.uid &&
        (
            (incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'creditLogs'])) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'schoolName']))
        );
    }
  }
}
